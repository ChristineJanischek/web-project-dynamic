          "theme": { "type": "string", "minLength": 1 },
          "variant": { "type": "string", "minLength": 1 },
          "task": { "type": "string", "enum": ["A", "B", "C", "D"] },
          "fingerprint": { "type": "string", "minLength": 32 },
          "preview": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }

{
  "profile_id": "webprojekte",
  "profile_name": "Web-Projekt Oberstufe 2026",
  "project_type": "web-php-static",
  "created": "2026-04-10",
  "version": "1.3",
  "grade_scale": {
    "best": 1.0,
    "worst": 6.0
  },
  "point_levels": {
    "sehr_gut": 4,
    "gut": 3,
    "befriedigend": 2,
    "ausreichend": 1,
    "nicht_erfuellt": 0
  },
  "max_points": 36,
  "criteria": [
    {
      "id": "A1",
      "title": "Formales – Syntax, MVC, kein Rechner/Automat, Abgabe",
      "description": "Prüfpunkte: (1) Syntaxfehlerfreiheit im PHP-Code, (2) Anwendung des MVC-Konzepts, (3) kein dynamischer Teil vom Typ Rechner/Automat, (4) Abgabezeitpunkt. Kostia und Nikita: 20 Minuten verspätet, mild bewerten.",
      "max_points": 4,
      "kind": "manual",
      "config": {},
      "evidence_hint": "Vier Teilprüfungen werden automatisch dokumentiert; Sonderregel zur milden Verspätung ist hinterlegt."
    },
    {
      "id": "B1",
      "title": "Projektstruktur und Quellcode-Qualität",
      "description": "Sinnvolle Ordnerstruktur, aussagekräftige Dateinamen, Einrückung und Übersichtlichkeit, relative Pfade, Trennung von CSS und PHP, keine unnötigen Wiederholungen.",
      "max_points": 4,
      "kind": "all_of",
      "config": {
        "rules": [
          {
            "kind": "file_exists",
            "config": {
              "glob": "index.php"
            },
            "label": "Einstiegspunkt index.php vorhanden"
          },
          {
            "kind": "any_of",
            "config": {
              "label": "CSS von PHP getrennt (eigene CSS-Datei)",
              "rules": [
                {
                  "kind": "min_files_glob",
                  "config": {
                    "glob": "css/*.css",
                    "min": 1
                  }
                },
                {
                  "kind": "min_files_glob",
                  "config": {
                    "glob": "styles/*.css",
                    "min": 1
                  }
                },
                {
                  "kind": "min_files_glob",
                  "config": {
                    "glob": "*.css",
                    "min": 1
                  }
                }
              ]
            }
          },
          {
            "kind": "any_of",
            "config": {
              "label": "Trennende Ordnerstruktur für PHP-Inhalte",
              "rules": [
                {
                  "kind": "file_exists",
                  "config": {
                    "glob": "layouts/*.php"
                  }
                },
                {
                  "kind": "file_exists",
                  "config": {
                    "glob": "includes/*.php"
                  }
                },
                {
                  "kind": "file_exists",
                  "config": {
                    "glob": "pages/*.php"
                  }
                }
              ]
            }
          }
        ]
      },
      "evidence_hint": "Einrückung, relative PHP-Pfade (require __DIR__) und Effizienz manuell prüfen."
    },
    {
      "id": "C1",
      "title": "Dynamisches Layout und Inhalt",
      "description": "PHP-Includes für dynamisches Layout, Box-Layout per CSS (Flexbox/Grid), HTML5-Elemente, Viewport-Meta-Tag, Barrierefrei-Grundlagen.",
      "max_points": 4,
      "kind": "all_of",
      "config": {
        "rules": [
          {
            "kind": "contains_regex",
            "config": {
              "glob": "**/*.php",
              "regex": "\\b(?:include|require)(?:_once)?\\b"
            },
            "label": "PHP-Includes für dynamisches Layout"
          },
          {
            "kind": "contains_regex",
            "config": {
              "glob": "**/*.php",
              "regex": "name=[\"']viewport[\"']"
            },
            "label": "Viewport-Meta-Tag für mobile Darstellung"
          },
          {
            "kind": "contains_regex",
            "config": {
              "glob": "**/*.css",
              "regex": "display\\s*:\\s*(?:flex|grid)"
            },
            "label": "Modernes CSS-Layout (Flexbox oder Grid)"
          }
        ]
      },
      "evidence_hint": "Box-Modell-Umsetzung und Browserkompatibilität manuell prüfen."
    },
    {
      "id": "D1",
      "title": "Bilder und Galerie",
      "description": "Mindestens 3 Bilder vorhanden, img-Tag mit alt-Attribut, Galerie/Preview/View per JavaScript oder CSS mit Syntaxcheck, Bildoptimierung (<200 KB), externe Quellen mit target=_blank.",
      "max_points": 4,
      "kind": "all_of",
      "config": {
        "rules": [
          {
            "kind": "any_of",
            "config": {
              "label": "Mindestens 3 Bilder vorhanden (images/, img/, bilder/ oder assets/)",
              "rules": [
                {
                  "kind": "min_files_glob",
                  "config": { "glob": "images/*", "min": 3 }
                },
                {
                  "kind": "min_files_glob",
                  "config": { "glob": "img/*", "min": 3 }
                },
                {
                  "kind": "min_files_glob",
                  "config": { "glob": "bilder/*", "min": 3 }
                },
                {
                  "kind": "min_files_glob",
                  "config": { "glob": "assets/images/*", "min": 3 }
                },
                {
                  "kind": "min_files_glob",
                  "config": { "glob": "assets/img/*", "min": 3 }
                }
              ]
            }
          },
          {
            "kind": "any_of",
            "config": {
              "label": "img-Tag mit alt-Attribut vorhanden",
              "rules": [
                {
                  "kind": "contains_regex",
                  "config": {
                    "glob": "**/*.php",
                    "regex": "<img[^>]+alt="
                  }
                },
                {
                  "kind": "contains_regex",
                  "config": {
                    "glob": "**/*.html",
                    "regex": "<img[^>]+alt="
                  }
                }
              ]
            }
          },
          {
            "kind": "any_of",
            "config": {
              "label": "Preview/View fuer Bilder ueber JavaScript oder CSS inkl. Syntaxcheck",
              "rules": [
                {
                  "kind": "all_of",
                  "config": {
                    "rules": [
                      {
                        "kind": "any_of",
                        "config": {
                          "label": "Preview/View-Logik im JavaScript-Kontext vorhanden",
                          "rules": [
                            {
                              "kind": "contains_regex",
                              "config": {
                                "glob": "**/*.js",
                                "regex": "(?i)preview|lightbox|modal|viewer|gallery|carousel|showImage|openImage"
                              }
                            },
                            {
                              "kind": "contains_regex",
                              "config": {
                                "glob": "**/*.php",
                                "regex": "(?i)<script[^>]*>|preview|lightbox|modal|viewer|gallery|carousel"
                              }
                            },
                            {
                              "kind": "contains_regex",
                              "config": {
                                "glob": "**/*.html",
                                "regex": "(?i)<script[^>]*>|preview|lightbox|modal|viewer|gallery|carousel"
                              }
                            }
                          ]
                        }
                      },
                      {
                        "kind": "syntax_check_glob",
                        "config": {
                          "glob": "**/*.js",
                          "language": "javascript",
                          "min": 1
                        },
                        "label": "JavaScript-Syntax geprueft"
                      }
                    ]
                  }
                },
                {
                  "kind": "all_of",
                  "config": {
                    "rules": [
                      {
                        "kind": "contains_regex",
                        "config": {
                          "glob": "**/*.css",
                          "regex": "(?i)(?:\\.preview|\\.lightbox|\\.modal|\\.viewer|\\.gallery|:target)"
                        },
                        "label": "Preview/View-Klassen oder :target in CSS vorhanden"
                      },
                      {
                        "kind": "syntax_check_glob",
                        "config": {
                          "glob": "**/*.css",
                          "language": "css",
                          "min": 1
                        },
                        "label": "CSS-Syntax geprueft"
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      },
      "evidence_hint": "Bildoptimierung (<200 KB je Bild), Bedienbarkeit von Preview/View im Browser und Verlinkung externer Quellen manuell pruefen."
    },
    {
      "id": "E1",
      "title": "Verweise – interne und externe Links",
      "description": "Sinnvolle interne Navigation zwischen Seiten, externe Links mit target=_blank.",
      "max_points": 4,
      "kind": "all_of",
      "config": {
        "rules": [
          {
            "kind": "contains_regex",
            "config": {
              "glob": "**/*.php",
              "regex": "<a\\s[^>]*href="
            },
            "label": "Links (<a href=…>) vorhanden"
          },
          {
            "kind": "contains_regex",
            "config": {
              "glob": "**/*.php",
              "regex": "target=[\"']_blank[\"']"
            },
            "label": "Externe Links mit target=_blank"
          }
        ]
      },
      "evidence_hint": "Qualität und Sinnhaftigkeit der Navigation manuell prüfen."
    },
    {
      "id": "F1",
      "title": "PHP-Eigenanteil und Formulare",
      "description": "Eigenständige PHP-Logik über die Mindestanforderung hinaus, Formulare mit POST/GET-Verarbeitung, Ideenreichtum und Umfang.",
      "max_points": 4,
      "kind": "all_of",
      "config": {
        "rules": [
          {
            "kind": "min_files_glob",
            "config": {
              "glob": "**/*.php",
              "min": 5
            },
            "label": "Mindestens 5 PHP-Dateien (Umfang)"
          },
          {
            "kind": "any_of",
            "config": {
              "label": "Formularverarbeitung (POST/GET oder <form>)",
              "rules": [
                {
                  "kind": "contains_regex",
                  "config": {
                    "glob": "**/*.php",
                    "regex": "\\$_POST|\\$_GET|\\$_REQUEST"
                  }
                },
                {
                  "kind": "contains_regex",
                  "config": {
                    "glob": "**/*.php",
                    "regex": "<form\\b"
                  }
                }
              ]
            }
          }
        ]
      },
      "evidence_hint": "Ideenreichtum, Eigenleistung und PHP-Qualität jenseits der Mindestanforderung manuell bewerten."
    },
    {
      "id": "H1",
      "title": "Dokumentation aller Inhalte und Quellcodes",
      "description": "Kommentare in CSS, PHP und ggf. JS; Nachvollziehbarkeit für Dritte.",
      "max_points": 4,
      "kind": "any_of",
      "config": {
        "rules": [
          {
            "kind": "contains_regex",
            "config": {
              "glob": "**/*.css",
              "regex": "\\/\\*"
            },
            "label": "CSS-Kommentare vorhanden"
          },
          {
            "kind": "contains_regex",
            "config": {
              "glob": "**/*.php",
              "regex": "\\/\\/|\\/\\*"
            },
            "label": "PHP-Kommentare vorhanden"
          }
        ]
      },
      "evidence_hint": "Qualität und Vollständigkeit der Kommentierung manuell prüfen."
    },
    {
      "id": "I1",
      "title": "Farbgestaltung und Design",
      "description": "Optisch gelungene Farbgebung, abgerundete Boxen (border-radius), Schatteneffekte (box-shadow), Farbverläufe (gradient), Hover-/Mouseovereffekte, Animationen sowie flexibles Layout (Grid/Flex) und responsive @media-Regeln.",
      "max_points": 4,
      "kind": "all_of",
      "config": {
        "rules": [
          {
            "kind": "contains_regex",
            "config": {
              "glob": "**/*.css",
              "regex": "display\\s*:\\s*(?:flex|inline-flex|grid|inline-grid)"
            },
            "label": "Flexibles Layout via Grid/Flex definiert"
          },
          {
            "kind": "any_of",
            "config": {
              "label": "Grid/Flex-Eigenschaften werden verwendet",
              "rules": [
                {
                  "kind": "contains_regex",
                  "config": {
                    "glob": "**/*.css",
                    "regex": "grid-template|grid-area|grid-column|grid-row|gap"
                  }
                },
                {
                  "kind": "contains_regex",
                  "config": {
                    "glob": "**/*.css",
                    "regex": "flex-direction|flex-wrap|justify-content|align-items|align-content"
                  }
                }
              ]
            }
          },
          {
            "kind": "contains_regex",
            "config": {
              "glob": "**/*.css",
              "regex": "@media\\s*\\("
            },
            "label": "Responsive Regeln mit @media vorhanden"
          },
          {
            "kind": "contains_regex",
            "config": {
              "glob": "**/*.css",
              "regex": "border-radius"
            },
            "label": "Abgerundete Boxen (border-radius)"
          },
          {
            "kind": "contains_regex",
            "config": {
              "glob": "**/*.css",
              "regex": ":hover"
            },
            "label": "Hover-Effekte vorhanden"
          },
          {
            "kind": "any_of",
            "config": {
              "label": "Weitere Designeffekte (Schatten, Verlauf oder Animation)",
              "rules": [
                {
                  "kind": "contains_regex",
                  "config": {
                    "glob": "**/*.css",
                    "regex": "box-shadow"
                  }
                },
                {
                  "kind": "contains_regex",
                  "config": {
                    "glob": "**/*.css",
                    "regex": "gradient"
                  }
                },
                {
                  "kind": "contains_regex",
                  "config": {
                    "glob": "**/*.css",
                    "regex": "transition|animation|@keyframes"
                  }
                }
              ]
            }
          }
        ]
      },
      "evidence_hint": "Gesamteindruck, gestalterische Konsistenz und tatsaechliche responsive Wirkung im Browser manuell pruefen."
    },
    {
      "id": "J1",
      "title": "Sonstige Features – Impressum, Datenschutz und KI-Inhalte",
      "description": "Impressum, Haftungsausschluss, Datenschutzerklaerung, korrekte Zitation von KI-generierten Inhalten sowie Quell-/Lizenzangaben fuer Bildmaterial.",
      "max_points": 4,
      "kind": "all_of",
      "config": {
        "rules": [
          {
            "kind": "any_of",
            "config": {
              "label": "Impressum vorhanden",
              "rules": [
                {
                  "kind": "file_exists",
                  "config": { "glob": "pages/impressum.php" }
                },
                {
                  "kind": "file_exists",
                  "config": { "glob": "impressum.php" }
                },
                {
                  "kind": "file_exists",
                  "config": { "glob": "impressum.html" }
                },
                {
                  "kind": "file_exists",
                  "config": { "glob": "layouts/impressum.php" }
                },
                {
                  "kind": "contains_regex",
                  "config": {
                    "glob": "**/*.php",
                    "regex": "(?i)<h[1-6][^>]*>\\s*impressum"
                  },
                  "label": "Impressum-Überschrift in PHP-Datei"
                }
              ]
            }
          },
          {
            "kind": "any_of",
            "config": {
              "label": "Datenschutz oder Haftungsausschluss vorhanden",
              "rules": [
                {
                  "kind": "file_exists",
                  "config": { "glob": "pages/datenschutz.php" }
                },
                {
                  "kind": "file_exists",
                  "config": { "glob": "datenschutz.php" }
                },
                {
                  "kind": "file_exists",
                  "config": { "glob": "pages/haftung.php" }
                },
                {
                  "kind": "file_exists",
                  "config": { "glob": "layouts/datenschutz.php" }
                },
                {
                  "kind": "file_exists",
                  "config": { "glob": "layouts/haftung.php" }
                },
                {
                  "kind": "contains_regex",
                  "config": {
                    "glob": "**/*.php",
                    "regex": "(?i)datenschutz|haftungsausschluss|haftung"
                  },
                  "label": "Datenschutz/Haftung als Inhalt in PHP-Datei"
                }
              ]
            }
          },
          {
            "kind": "any_of",
            "config": {
              "label": "Quell-/Lizenzangaben fuer Bildmaterial vorhanden",
              "rules": [
                {
                  "kind": "contains_regex",
                  "config": {
                    "glob": "**/*.php",
                    "regex": "(?i)bildnachweis|bildquelle|quelle(?:n)?|lizenz|urheber|copyright|unsplash|pixabay|pexels|creative\\s*commons|cc-by"
                  }
                },
                {
                  "kind": "contains_regex",
                  "config": {
                    "glob": "**/*.html",
                    "regex": "(?i)bildnachweis|bildquelle|quelle(?:n)?|lizenz|urheber|copyright|unsplash|pixabay|pexels|creative\\s*commons|cc-by"
                  }
                },
                {
                  "kind": "contains_regex",
                  "config": {
                    "glob": "**/*.md",
                    "regex": "(?i)bildnachweis|bildquelle|quelle(?:n)?|lizenz|urheber|copyright|unsplash|pixabay|pexels|creative\\s*commons|cc-by"
                  }
                },
                {
                  "kind": "contains_regex",
                  "config": {
                    "glob": "**/*.txt",
                    "regex": "(?i)bildnachweis|bildquelle|quelle(?:n)?|lizenz|urheber|copyright|unsplash|pixabay|pexels|creative\\s*commons|cc-by"
                  }
                }
              ]
            }
          }
        ]
      },
      "evidence_hint": "Vollstaendigkeit von Impressum/Datenschutz, KI-Zitationen und Bildquellen/Lizenzen inhaltlich manuell pruefen."
    }
  ]
